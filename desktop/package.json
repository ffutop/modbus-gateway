{
  "name": "modmux-desktop",
  "productName": "ModMux",
  "version": "0.6.0",
  "private": true,
  "description": "ModMux desktop edition: the management console in a native window, running the bundled modbus-gateway binary as a child process.",
  "main": "main.js",
  "author": "ffutop",
  "license": "BSD-3-Clause",
  "scripts": {
    "start": "electron .",
    "test": "playwright test --project=app",
    "test:packaged": "playwright test --project=packaged",
    "dist:mac-x64": "node scripts/dist.js mac x64",
    "dist:mac-arm64": "node scripts/dist.js mac arm64",
    "dist:win-x64": "node scripts/dist.js win x64",
    "dist:win-arm64": "node scripts/dist.js win arm64",
    "dist:linux-x64": "node scripts/dist.js linux x64",
    "dist:linux-arm64": "node scripts/dist.js linux arm64"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ffutop.modmux",
    "productName": "ModMux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "gateway-process.js",
      "config-files.js",
      "stopped.html",
      "stopped.js",
      "tokens.css",
      "stopped.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin/${os}-${arch}",
        "to": "bin"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "ffutop",
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/ffutop/modbus-gateway",
  "desktopName": "modmux.desktop"
}
